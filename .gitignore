# Kconfig current selection — generated by `make menuconfig` / `make defconfig-*`.
# Tracked per-deployment via defconfigs/*.config (committed); not here.
.config
.config.old
# iCloud / Finder duplicates (".config 2", ".config 3.old", etc.) — same role.
.config[ .]*

# Build artifacts
/target/
/build/
# Per-crate target dirs (workspace-excluded host-test crates, demos, and
# userspace each build into their own target/). Catch-all so a new crate
# can't accidentally commit build artifacts again.
**/target/

# RFC-0027 WCET: generated per-function point table (source of truth is
# crates/drivers/wcet_points.json which IS committed; this .rs file is
# regenerated by crates/drivers/build.rs on every cargo build).
crates/drivers/src/wcet_points_generated.rs

# Disk images
*.img

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Editor
.DS_Store
*.swp
*.swo
*~

# Agent / AI editor instructions
AGENTS.md

# Other agentic-IDE workspace metadata
.antigravitycli/

tools/keys/

# mdBook HTML output
book/book/

# TLC model-checker artifacts
formal/tla/*_TTrace_*.tla
formal/tla/*_TTrace_*.bin
formal/tla/states/
tools/tla2tools.jar
